# ===== Serveur =====
NODE_ENV=development
PORT=4000
# URL publique du frontend (CORS + liens dans les emails)
FRONTEND_URL=http://localhost:3000
# URL publique de l'API (liens de paiement / webhooks)
API_PUBLIC_URL=http://localhost:3000/api

# ===== Base de données MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=viva
DB_PASSWORD=change_me
DB_NAME=viva_live_better

# ===== Sécurité =====
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# ===== Compte administrateur créé par le seed =====
ADMIN_EMAIL=admin@vivalivebetter.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=VIVA

# ===== Boutique =====
CURRENCY=USD
FREE_SHIPPING_THRESHOLD=49
TAX_RATE=0
PAYMENT_TIMEOUT_MIN=120

# ===== Emails (SMTP). Si SMTP_HOST est vide, les emails sont affichés dans la console =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VIVA Live Better <no-reply@vivalivebetter.com>"

# ===== Paiements =====
# sandbox : paiement simulé (développement). Mettre "live" en production.
PAYMENT_MODE=sandbox
# Secret partagé pour vérifier la signature (HMAC SHA-256) des webhooks Mobile Money
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
# Carte bancaire via Stripe (optionnel) : si renseigné, Stripe Checkout est utilisé
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Coordonnées affichées pour le virement bancaire
BANK_TRANSFER_DETAILS="IBAN FR76 0000 0000 0000 0000 0000 000 - BIC VIVAFRPP - Bénéficiaire : VIVA Live Better"

# ===== Téléversement d'images =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
