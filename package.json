{
  "name": "viva-live-better",
  "version": "2.0.0",
  "private": true,
  "description": "Plateforme e-commerce VIVA Live Better (Next.js + Express + MySQL)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed:demo": "npm --prefix backend run db:seed -- --demo",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start:api": "npm --prefix backend start",
    "start:web": "npm --prefix frontend start",
    "test": "npm --prefix backend test"
  }
}
